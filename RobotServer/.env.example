# --- Server ---
NODE_ENV=development
PORT=8000

# --- Mongo (maps + saved goal poses) ---
MONGO_URI=mongodb://localhost:27017/autonav

# --- CORS ---
# Comma-separated list of origins allowed to call this API. The robot has no
# auth of its own — the VPN is the trust boundary (see root README) — so this
# is about restricting which browser origins may issue cross-origin requests,
# not about authentication.
CORS_ORIGINS=http://localhost:5173

# --- Filesystem ---
MAPS_DIR=./maps

# --- Camera (WebRTC video, see modules/video) ---
CAMERA_DEVICE=/dev/robotcam

# --- Service-to-service (this robot <-> PlatformServer) ---
# No secret: the VPN is the trust boundary. This robot identifies itself to
# PlatformServer with its own device id (robotId, as provisioned via
# POST /api/admin/robots), resolved from the ESP32 bridge at boot — see
# ros/deviceIdentity.ts. Nothing to configure here for that.
PLATFORM_BASE_URL=http://platform.internal:4000
ROSTER_SYNC_INTERVAL_MINUTES=60

# --- Robot-link (this robot <-> PlatformServer's /ws/robot-link) ---
# The one service-to-service value that IS a secret: it's what lets
# PlatformServer trust "robot online" as a push-based fact instead of a
# VPN-membership guess. Plaintext value issued once by
# POST /api/admin/robots at provisioning time; only its sha256 hash is ever
# stored on PlatformServer, so losing this means rotating it via
# POST /api/admin/robots/:robotId/rotate-link-secret.
ROBOT_LINK_SECRET=changeme-issued-at-robot-provisioning

# --- Local dev only: lets RobotServer boot without a real ESP32 attached ---
# DEV_DEVICE_ID_OVERRIDE=dev-robot-01

# --- Teleop safety limits (see modules/teleop/teleop.service.ts) ---
# Defaults match autonav_navigation/config/navigation.yaml's DWB
# max_velocity: [0.4, 0.0, 1.1] — the same envelope Nav2 is already tuned
# to stay inside.
TELEOP_MAX_LINEAR=0.4
TELEOP_MAX_ANGULAR=1.1

# --- RobotApp (local HMI PWA) human session ---
ROBOT_SESSION_ACCESS_SECRET=changeme-robot-session-access-secret
ROBOT_SESSION_REFRESH_SECRET=changeme-robot-session-refresh-secret
ROBOT_SESSION_ACCESS_TTL=15m
ROBOT_SESSION_REFRESH_TTL=24h
PIN_LOGIN_MAX_ATTEMPTS=5
PIN_LOGIN_LOCKOUT_MINUTES=15

# --- RobotApp static bundle (built from ../RobotApp, copied in at image build time) ---
ROBOTAPP_STATIC_DIR=./robotapp-dist
