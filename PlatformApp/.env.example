# Base URL for PlatformServer's API. In production the API is served from its
# own subdomain (https://platform-server.autonav.in/api) via nginx — see
# AWS/nginx/platform-server.autonav.in.conf — separate from the dashboard
# frontend's domain (dashboard.autonav.in). In local dev, PlatformServer runs
# on a different port, so it must be absolute there too.
VITE_API_BASE_URL=http://localhost:4000/api
