<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="autonav">

    <ros2_control name="RobotSystem" type="system">

        <!-- ros2_control Gazebo -->
        <hardware>
            <plugin>autonav_firmware/AutonavInterface</plugin>
            <param name="left_port">/dev/ttyUSB0</param>
            <param name="right_port">/dev/ttyACM0</param>
            <param name="left_slave_id">2</param>
            <param name="right_slave_id">1</param>
        </hardware>
        
        <!-- ros2_control Common Interfaces -->
        <joint name="base2right">
            <command_interface name="velocity">
              <param name="min">-20</param>
              <param name="max">20</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="base2left">
            <command_interface name="velocity">
              <param name="min">-20</param>
              <param name="max">20</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        
    </ros2_control>

</robot>