# --- Server ---
NODE_ENV=development
PORT=4000

# --- Mongo ---
MONGO_URI=mongodb://localhost:27017/autonav_platform_dev

# --- JWT ---
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Admin bootstrap ---
ADMIN_EMAILS=jatinpatil2003@gmail.com

# --- Frontend / cookies ---
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# --- Google OAuth ---
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Password reset OTP (email) ---
# Free Gmail SMTP delivery: enable 2FA on the Gmail account, then generate an
# "App Password" at https://myaccount.google.com/apppasswords and use it
# here (not your real Gmail password).
EMAIL_USER=changeme@gmail.com
EMAIL_APP_PASSWORD=changeme
OTP_EXPIRY_MINUTES=10
RESET_TOKEN_SECRET=changeme-reset-token-secret
RESET_TOKEN_TTL=10m
