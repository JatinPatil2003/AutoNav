# --- Server ---
NODE_ENV=development
PORT=4000

# --- Mongo ---
MONGO_URI=mongodb://localhost:27017/autonav_platform_dev

# --- JWT ---
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# --- Admin bootstrap ---
ADMIN_EMAILS=jatinpatil2003@gmail.com

# --- Frontend / cookies ---
FRONTEND_URL=http://localhost:5173
COOKIE_DOMAIN=localhost

# --- Google OAuth ---
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# --- Password reset OTP (email) ---
# Free Gmail SMTP delivery: enable 2FA on the Gmail account, then generate an
# "App Password" at https://myaccount.google.com/apppasswords and use it
# here (not your real Gmail password).
EMAIL_USER=changeme@gmail.com
EMAIL_APP_PASSWORD=changeme
OTP_EXPIRY_MINUTES=10
RESET_TOKEN_SECRET=changeme-reset-token-secret
RESET_TOKEN_TTL=10m

# --- Robot (RobotServer <-> PlatformServer) ---
# No secret: the VPN is the trust boundary. A robot identifies itself with
# its own device id (robotId), resolved on its side from the ESP32 bridge.
PIN_SETUP_TOKEN_SECRET=changeme-pin-setup-token-secret
PIN_SETUP_TOKEN_TTL=10m
# Scheme/timeout used when PlatformServer calls a robot's own RobotServer
# over the VPN (e.g. the roster-invalidate push on revoke).
ROBOT_CALL_SCHEME=https
ROBOT_CALL_TIMEOUT_MS=5000

# --- Control relay (/ws/control) ---
# Defense-in-depth clamps mirroring RobotServer's authoritative TeleopService
# clamps — keep these in sync with that service's own env if you change either.
TELEOP_MAX_LINEAR=0.4
TELEOP_MAX_ANGULAR=1.1
# Timeout for the one-shot health.query round trip over /ws/robot-link,
# used by GET /api/robots/:robotId/health.
HEALTH_QUERY_TIMEOUT_MS=2000
