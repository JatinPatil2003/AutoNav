# Base URL the app's RTK Query client talks to. For a release build this is
# the public PlatformServer domain; for local dev against a physical device
# on the same LAN, point it at your dev machine's LAN IP instead of
# localhost (the device can't resolve your machine's localhost).
VITE_API_BASE_URL=https://platform-server.autonav.in/api

# wss:// origin for the /ws/control relay. Derived separately from
# VITE_API_BASE_URL (rather than string-replacing http->ws at runtime)
# because the API base includes the /api suffix and the WS endpoint does not.
VITE_WS_BASE_URL=wss://platform-server.autonav.in

# Web OAuth Client ID from Google Cloud Console — NOT an Android client ID.
# Must match the audience PlatformServer's verifyGoogleIdToken checks.
VITE_GOOGLE_WEB_CLIENT_ID=
